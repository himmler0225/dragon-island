// Database schema. After editing: `npm run db:migrate -- --name <change>` (creates a migration and
// regenerates the client in src/generated/prisma).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  level        Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  dragons Dragon[]
  teams   TeamSetup?

  @@map("users")
}

model Dragon {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  /// species id, see src/modules/dragons/dragon-species.ts
  species   String
  nickname  String?
  stars     Int      @default(1)
  level     Int      @default(1)
  exp       Int      @default(0)
  /// hunger as it was at hungerAt; the current value is worked out from the time since (no ticking)
  hunger    Float    @default(100)
  hungerAt  DateTime @default(now()) @map("hunger_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("dragons")
}

/// Hand tweaks to a dragon rig, set in the frontend's rig editor (/dev/rig-editor): each piece (bone) of a
/// species drawn shifted (dx, dy: rig px, in the piece's own frame), turned (rot: radians) and scaled on top of
/// the pose rig.json gives it. The game reads them all at start (GET /api/rig-tweaks).
model RigTweak {
  species   String
  bone      String
  dx        Float    @default(0)
  dy        Float    @default(0)
  rot       Float    @default(0)
  scale     Float    @default(1)
  /// drawn mirrored left-right (about its joint)
  flipX     Boolean  @default(false) @map("flip_x")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([species, bone])
  @@map("rig_tweaks")
}

/// What the rig editor's eraser took off a piece's image: a PNG (data URL) the size of the piece's image, opaque where
/// erased. The game cuts it out of the piece when it loads the rig.
model RigMask {
  species   String
  bone      String
  png       String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([species, bone])
  @@map("rig_masks")
}

/// Đội hình: a player's saved teams (TEAM_COUNT lists of TEAM_SIZE slots, each a species id or null, in summon
/// order) and which one is active. One row per player, replaced whole on save.
model TeamSetup {
  ownerId   String   @id @map("owner_id") @db.Uuid
  teams     Json
  active    Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("team_setups")
}
