NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Supabase Storage: where the game's art and sounds live.
# Leave NEXT_PUBLIC_ASSET_BASE empty to serve the files from public/ instead (local dev default).
# After `npm run assets:sync`, set it to the bucket's public URL:
#   https://<project>.supabase.co/storage/v1/object/public/assets
NEXT_PUBLIC_ASSET_BASE=

# Only needed by `npm run assets:sync` (never exposed to the browser).
# The service_role key: Supabase dashboard -> Project Settings -> API Keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The bucket name (default: assets).
SUPABASE_BUCKET=assets
